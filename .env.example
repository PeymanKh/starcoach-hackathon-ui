# Backend base URL.
# Local: leave empty. Vite proxies /api to the Django dev server (see API_PROXY_TARGET).
# Vercel: the backend's public URL, e.g. https://api.example.com (Django must allow this origin via CORS).
VITE_API_URL=

# Local only: where the Vite dev server forwards /api requests.
API_PROXY_TARGET=http://localhost:8000
